# DIRECT_URL="postgresql://username:password@ep-sample.us-east-1.aws.neon.tech/kirana_sathi?sslmode=require"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Authentication & Security
JWT_SECRET="your-256-bit-jwt-secret-replace-in-production-min-32-chars"
NEXTAUTH_SECRET="your-nextauth-secret-replace-in-production"

# Payment Gateway (Razorpay)
# For testing: Use 'rzp_test_...' keys. If empty or demo, application runs in safe Sandbox/Demo mode.
RAZORPAY_KEY_ID="rzp_test_kirana_demo_key"
RAZORPAY_KEY_SECRET="rzp_test_kirana_demo_secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_kirana_demo_key"
RAZORPAY_WEBHOOK_SECRET="rzp_webhook_secret_key"

# Media Storage (Cloudinary or AWS S3 Compatible)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Notification Services (Optional / Production)
# Email SMTP
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
FROM_EMAIL="orders@kiranasathi.in"

# WhatsApp / SMS (Twilio or Gupshup - optional)
SMS_PROVIDER_API_KEY=""
SMS_SENDER_ID="KIRANA"

# Store Configuration Defaults
NEXT_PUBLIC_STORE_NAME="Kirana Sathi"
